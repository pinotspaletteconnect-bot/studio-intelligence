    {
      "parameters": {
        "jsCode": "const job = $input.first().json;\nconst organizationId = Number(job.organizationId);\nconst accountId = Number(job.accountId);\nif (![organizationId, accountId].every(Number.isSafeInteger)) {\n  throw new Error('Daily Sales audit job identifiers are invalid');\n}\nif (!Array.isArray(job.studioTargets) || job.studioTargets.length === 0) {\n  throw new Error('Daily Sales audit job has no studio targets');\n}\nlet reportDate = String(job.reportDate || '').trim();\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(reportDate)) {\n  const d = new Date();\n  d.setUTCDate(d.getUTCDate() - 1);\n  reportDate = d.toISOString().slice(0, 10);\n}\nreturn [{ json: {\n  action: 'start',\n  organizationId,\n  accountId,\n  workflowName: '05B - PTS Daily Sales Multi-Account',\n  reportType: 'daily_sales',\n  requestedFromDate: reportDate,\n  requestedToDate: reportDate,\n  executionReference: String($execution.id),\n  attemptCount: 1,\n  collectorJob: { ...job, reportDate }\n} }];"
      },
