      "id": "e53ad09d-a0e6-4ba6-bbb3-329496672303",
      "name": "Get PTS Account Jobs",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [360, 230]
    },
    {
      "parameters": {
        "jsCode": "const jobs = $input.all().map(item => item.json);\nconst today = new Date();\nconst from = new Date(today); from.setUTCDate(from.getUTCDate() - 30);\nconst to = new Date(today); to.setUTCDate(to.getUTCDate() + 90);\nreturn jobs.filter(job => Array.isArray(job.studioTargets) && job.studioTargets.some(studio => Array.isArray(studio.reports) && studio.reports.includes('third_party_class_credits'))).map(job => ({ json: { ...job, fromDate: from.toISOString().slice(0,10), toDate: to.toISOString().slice(0,10) } }));"
      },
      "id": "e53ad09d-a0e6-4ba6-bbb3-329496672304",
      "name": "Keep Enabled Accounts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 230]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://studio-intelligence-production.up.railway.app/pts/third-party-class-credits-report",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ organizationId: $json.organizationId, accountId: $json.accountId, fromDate: $json.fromDate, toDate: $json.toDate }) }}",
        "options": { "timeout": 600000 }
      },
      "id": "e53ad09d-a0e6-4ba6-bbb3-329496672305",
      "name": "Collect Third Party Credits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [840, 230],
      "credentials": { "httpHeaderAuth": { "id": "REPLACE_COLLECTOR_CREDENTIAL_ID", "name": "Studio Intelligence Collector API" } }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst organizationId = Number(response.organizationId);\nif (!Number.isSafeInteger(organizationId)) throw new Error('Third-party credits response is missing organizationId');\nconst retrievedAt = new Date().toISOString();\nconst rows = [];\nfor (const result of response.results || []) {\n  const studioId = Number(result.studioId);\n  const brandId = Number(result.brandId);\n  if (![studioId, brandId].every(Number.isSafeInteger)) throw new Error('Third-party credit result has invalid tenant identifiers');\n  for (const credit of result.rows || []) rows.push({ json: { organization_id: organizationId, brand_id: brandId, studio_id: studioId, pts_location_id: String(result.locationId), ...credit, retrieved_at: retrievedAt, updated_at: retrievedAt } });\n}\nreturn rows;"
      },
      "id": "e53ad09d-a0e6-4ba6-bbb3-329496672306",
      "name": "Build Credit Upserts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 230]
    },
