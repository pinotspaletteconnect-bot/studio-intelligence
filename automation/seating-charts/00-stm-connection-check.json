{
  "name": "00 - Seating Charts - STM connection check",
  "active": false,
  "nodes": [
    {
      "id": "seating-check-0",
      "name": "Manual connection check",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "seating-check-1",
      "name": "Read connected Google identity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/about?fields=user(emailAddress)",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "Fmbjd7IWMJeb4vZQ",
          "name": "St Matthews Seating Charts — Google Drive"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "seating-check-2",
      "name": "Require studio account",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const expected=\"pinotsstmatthews@gmail.com\";\nconst actual=String($input.first().json.user?.emailAddress||'').toLowerCase();\nif(actual!==expected.toLowerCase())throw new Error('Google account mismatch: expected '+expected+'; connected '+(actual||'unknown'));\nreturn [{json:{studioCode:\"STM\",accountVerified:true}}];"
      }
    },
    {
      "id": "seating-check-3",
      "name": "Verify master access",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files/1ktf-zV74f--JWaaPlrrtYgmbLVGI6ZJI9JdArrYootA?fields=id%2Cname%2CmimeType%2Cparents%2Cowners(emailAddress)%2Ccapabilities(canCopy%2CcanEdit)",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "Fmbjd7IWMJeb4vZQ",
          "name": "St Matthews Seating Charts — Google Drive"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "seating-check-4",
      "name": "Require studio master",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "const file=$input.first().json;\nif(file.id!==\"1ktf-zV74f--JWaaPlrrtYgmbLVGI6ZJI9JdArrYootA\"||file.mimeType!=='application/vnd.google-apps.spreadsheet'||file.capabilities?.canCopy!==true)throw new Error('Master cannot be verified or copied');\nif(!file.owners?.some(o=>o.emailAddress?.toLowerCase()===\"pinotsstmatthews@gmail.com\"))throw new Error('Master owner does not match the studio');\nreturn [{json:{masterVerified:true}}];"
      }
    },
    {
      "id": "seating-check-5",
