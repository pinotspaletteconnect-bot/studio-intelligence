      "waitBetweenTries": 2000
    },
    {
      "id": "seating-check-6",
      "name": "Require studio folder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "jsCode": "const folder=$input.first().json;\nif(folder.id!==\"1-WqB2lVbK6e1j6Y0mCojZjPoCvmaJ4L7\"||folder.mimeType!=='application/vnd.google-apps.folder'||folder.capabilities?.canEdit!==true)throw new Error('Destination folder is not writable');\nif(!folder.owners?.some(o=>o.emailAddress?.toLowerCase()===\"pinotsstmatthews@gmail.com\"))throw new Error('Destination folder owner mismatch');\nreturn [{json:{folderVerified:true}}];"
      }
    },
    {
      "id": "seating-check-7",
