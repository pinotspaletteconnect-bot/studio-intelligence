      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "jsCode": "const sheet=$input.first().json;\nif(sheet.spreadsheetId!==\"1ktf-zV74f--JWaaPlrrtYgmbLVGI6ZJI9JdArrYootA\"||sheet.properties?.timeZone!==\"America/New_York\")throw new Error('Spreadsheet identity or timezone mismatch');\nreturn [{json:{studioCode:\"STM\",status:'connection_verified',writesPerformed:0,scheduleEnabled:false,masterTitle:sheet.properties.title,sheetCount:sheet.sheets.length}}];"
      }
    }
