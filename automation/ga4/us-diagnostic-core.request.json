{
  "dateRanges": [
    {
      "startDate": "2026-10-19",
      "endDate": "2026-11-15"
    }
  ],
  "dimensionFilter": {
    "filter": {
      "fieldName": "country",
      "stringFilter": {
        "matchType": "EXACT",
        "value": "United States",
        "caseSensitive": true
      }
    }
  },
  "funnel": {
    "isOpenFunnel": false,
    "steps": [
      {
        "name": "packages",
        "isDirectlyFollowedBy": false,
        "filterExpression": {
          "andGroup": {
            "expressions": [
              {
                "funnelEventFilter": {
                  "eventName": "page_view"
                }
              },
              {
                "funnelFieldFilter": {
                  "fieldName": "pagePathPlusQueryString",
                  "stringFilter": {
                    "matchType": "FULL_REGEXP",
                    "value": "^/louisville/parties/packages(\\?.*)?$",
                    "caseSensitive": true
                  }
                }
              }
            ]
          }
        }
      },
      {
